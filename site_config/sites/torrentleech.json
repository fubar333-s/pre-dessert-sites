{
  "id": "torrentleech",
  "name": "TorrentLeech",
  "domain": "https://www.torrentleech.org",
  "public": false,
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": false
  },
  "requests": {
    "favicon": {
      "parser": "None",
      "method": "GET",
      "path": "/favicon.ico"
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/",
      "disabled_extends": {
        "fields": true
      },
      "fields": {
        "is_login": {
          "selector": "//a[contains(@href, 'logout')]/@href",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/profile/([^/\"']+)/view",
                1
              ]
            }
          ]
        },
        "name": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "/profile/([^/\"']+)/view",
                1
              ]
            }
          ]
        },
        "uploaded": {
          "selector": "//div[@title='Uploaded (Seeding)']/span/text()",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "//div[@title='Downloaded (Leeching)']/span/text()",
          "filters": [
            {
              "name": "byte_size"
            }
          ]
        },
        "bonus": {
          "selector": "//span[@class='total-TL-points']/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/profile/{userId}/view",
      "disabled_extends": {
        "fields": true
      },
      "fields": {
        "ratio": {
          "selector": "//span[contains(@class,'profile-ratio-details')]/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                "∞",
                "0"
              ]
            },
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        },
        "level": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "<td>Class</td>\\s*<td>([^<]+)</td>",
                1
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "disabled": true
    },
    "search": {
      "disabled": true
    },
    "rss": {
      "disabled": true
    },
    "get_rss": {
      "disabled": true
    },
    "messages": {
      "disabled": true
    },
    "message_detail": {
      "disabled": true
    },
    "notice": {
      "disabled": true
    },
    "my_hr": {
      "disabled": true
    },
    "details": {
      "disabled": true
    },
    "get_subtitle_url": {
      "disabled": true
    },
    "shoutbox": {
      "disabled": true
    },
    "sign_in": {
      "disabled": true
    }
  }
}
