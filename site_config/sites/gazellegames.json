{
  "id": "gazellegames",
  "name": "GazelleGames",
  "domain": "https://gazellegames.net",
  "public": false,
  "reuse_schema": "NexusPHP",
  "required": {
    "cookie": true,
    "sign_in": false
  },
  "requests": {
    "favicon": {
      "parser": "None",
      "method": "GET",
      "path": "/favicon.ico"
    },
    "user_basic_info": {
      "parser": "XPath",
      "method": "GET",
      "path": "/index.php",
      "disabled_extends": {
        "fields": true
      },
      "fields": {
        "is_login": {
          "selector": "//a[contains(@href, 'logout.php')]/@href",
          "filters": [
            {
              "name": "not_blank"
            }
          ]
        },
        "id": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "class='username' href=\"user\\.php\\?id=(\\d+)\"",
                1
              ]
            }
          ]
        },
        "name": {
          "selector": "//a[@class='username']/text()"
        },
        "uploaded": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "([\\d,.]+ [KMGTPE]?i?B) Uploaded",
                1
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "downloaded": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "([\\d,.]+ [KMGTPE]?i?B) Downloaded",
                1
              ]
            },
            {
              "name": "byte_size"
            }
          ]
        },
        "bonus": {
          "selector": "//li[@id='stats_gold']/span/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        },
        "ratio": {
          "selector": "//li[@id='stats_ratio']/span/span/text()",
          "filters": [
            {
              "name": "replace",
              "args": [
                ",",
                ""
              ]
            }
          ]
        }
      }
    },
    "user_details": {
      "parser": "XPath",
      "method": "GET",
      "path": "/user.php?id={userId}",
      "disabled_extends": {
        "fields": true
      },
      "fields": {
        "level": {
          "selector": "*",
          "selection": "html",
          "filters": [
            {
              "name": "re_search",
              "args": [
                "<li>Class: ([^<]+)</li>",
                1
              ]
            }
          ]
        }
      }
    },
    "seeding_statistics": {
      "disabled": true
    },
    "search": {
      "disabled": true
    },
    "rss": {
      "disabled": true
    },
    "get_rss": {
      "disabled": true
    },
    "messages": {
      "disabled": true
    },
    "message_detail": {
      "disabled": true
    },
    "notice": {
      "disabled": true
    },
    "my_hr": {
      "disabled": true
    },
    "details": {
      "disabled": true
    },
    "get_subtitle_url": {
      "disabled": true
    },
    "shoutbox": {
      "disabled": true
    },
    "sign_in": {
      "disabled": true
    }
  }
}
